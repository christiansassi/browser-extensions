{
	"manifest_version": 3,
	"name": "Notion Theme",
	"version": "1.0.1",
	"description": "Forces light or dark color scheme on app.notion.com.",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": [
		"storage",
		"activeTab",
		"scripting"
	],
	"host_permissions": [
		"https://app.notion.com/*",
		"https://*.app.notion.com/*"
	],
	"action": {
		"default_title": "Notion Theme",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16-bw.png",
			"32": "icons/icon32-bw.png",
			"48": "icons/icon48-bw.png",
			"128": "icons/icon128-bw.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://app.notion.com/*",
				"https://*.app.notion.com/*"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_idle"
		}
	]
}
